# Copy to .env to override any default in src/fine_print/config.py.
# Every setting is optional. Names are the Settings field names, prefixed with FINE_PRINT_.

# FINE_PRINT_OLLAMA_URL=http://localhost:11434
# FINE_PRINT_OLLAMA_MODEL=gemma4:e4b
# FINE_PRINT_PROMPT_NAME=numbered
# FINE_PRINT_API_URL=http://localhost:8000
# FINE_PRINT_TOP_K=5
# FINE_PRINT_MIN_SIMILARITY=0.6
# FINE_PRINT_CHUNK_SIZE=1000
# FINE_PRINT_CHUNK_OVERLAP=150
# FINE_PRINT_DEFAULT_STRATEGY=section
# FINE_PRINT_LOG_JSON=false
# FINE_PRINT_LOG_LEVEL=INFO
